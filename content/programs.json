		{
			"type": "programSection",
			"attrs": {
				"id": "d55720c0-3116-552b-9ff8-bb95861120f9",
				"title": "PRO-Teen",
				"image": "/uploads/1b653856ec735208651868da37bec0ed.webp",
				"alt": "Teenagers and adult volunteers working in the PRO-Teen workshop"
			},
			"content": [
				{
					"type": "heading",
					"attrs": {
						"id": "1029ec5e-ddca-584d-8c08-896affbb88df",
						"level": 2
					},
					"content": [
						{
							"type": "text",
							"text": "Educational Program that Meets Needs of the Whole Person"
						}
					]
				},
				{
					"type": "heading",
					"attrs": {
						"id": "cd599fc0-a385-57ab-b6de-8c6011fec344",
						"level": 3
					},
					"content": [
						{
							"type": "text",
							"text": "Skills for Life"
						}
					]
				},
				{
					"type": "paragraph",
					"attrs": {
						"id": "a650ec5e-9e4a-5fd3-a4ba-2829b1a27067"
					},
					"content": [
						{
							"type": "text",
							"text": "Educational opportunities in the skilled trades are provided free of charge and instructed by local professionals."
						}
					]
				},
				{
					"type": "paragraph",
					"attrs": {
						"id": "509b7b43-8e18-581d-9d7b-51595d66e953"
					},
					"content": [
						{
							"type": "text",
							"text": "We currently have two lathes, a vertical milling machine, MIG welder, ARC welder, along with wood and metal saws. We instruct in machining, small engine repair, soldering, plumbing, electrical, masonry, and carpentry skills."
						}
					]
				},
