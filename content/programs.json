				"image": "/uploads/99a9084e055414b33f3a2d670ae47e13.webp",
				"alt": "Teenagers and adults with gravity racers at an Annual Events race"
			},
			"content": [
				{
					"type": "heading",
					"attrs": {
						"id": "422759ba-f488-5266-b49d-a91da745a37e",
						"level": 2
					},
					"content": [
						{
							"type": "text",
							"text": "The Annual Gravity Racers Classic, and"
						}
					]
				},
				{
					"type": "heading",
					"attrs": {
						"id": "6d5f9be0-8815-50b7-8508-decd2c9cdd55",
						"level": 2
					},
					"content": [
						{
							"type": "text",
							"text": "We GRILL OUT ON WEDNESDAYS DURING THE SUMMER."
						}
					]
				},
				{
					"type": "paragraph",
					"attrs": {
						"id": "d80466be-3d97-5d1d-a290-e73bb459a0ad"
					},
					"content": [
						{
							"type": "text",
							"text": "Youth and adults create gravity-powered cars that we race down the center of IKI Drive or Elm High Drive or both. "
						},
						{
							"type": "text",
							"text": "Car RULES & REGULATIONS are available HERE.",
							"marks": [
								{
									"type": "bold"
								},
								{
									"type": "italic"
								}
							]
						}
					]
				},
				{
					"type": "paragraph",
					"attrs": {
						"id": "9facb120-b671-56ed-bdbd-f36788dc7e0b"
					},
					"content": [
						{
							"type": "text",
							"text": "The City graciously closes off the street for the day and we race!",
							"marks": [
								{
									"type": "bold"
								}
							]
						}
					]
				},
				{
					"type": "paragraph",
					"attrs": {
						"id": "71b1ea56-a2df-598e-ad66-71c2df629a3d"
					},
					"content": [
						{
							"type": "text",
							"text": "This event typically begins at 9 am and runs until Noon. The top speed in the 500 feet race is 20MPH."
						}
					]
				},
				{
					"type": "heading",
					"attrs": {
						"id": "fcf2743b-a2fb-5a0c-928e-25f169aa93bf",
						"level": 3
					},
					"content": [
						{
							"type": "text",
							"text": "We host a NIGHT RACE too. Scroll down for pics of this event."
						}
					]
				},
				{
					"type": "paragraph",
					"attrs": {
						"id": "a6d5bdd8-893b-5e10-87c0-4e51fc79036f"
					},
					"content": [
						{
							"type": "text",
							"text": "The Gravity Racers Classic is free to race in and free to watch.",
							"marks": [
								{
									"type": "bold"
								}
							]
						},
						{
							"type": "text",
							"text": " "
						},
						{
							"type": "text",
							"text": "NO CHARGE EVER!",
