		{
			"type": "programSection",
			"attrs": {
				"id": "7c1f50f0-f865-5ec6-8f6e-ef67ef3fdaae",
				"title": "Arts and Entertainment",
				"image": "/uploads/174b0b6691445bb37bd8aae69b20abf9.webp",
				"alt": "Teenagers gathered for a concert at the Edgerton Teen Center"
			},
			"content": [
				{
					"type": "heading",
					"attrs": {
						"id": "eee4cb9c-dec0-5e22-9f4d-603feb58bba6",
						"level": 2
					},
					"content": [
						{
							"type": "text",
							"text": "Go Right or Go Left: the fun is all around you!"
						}
					]
				},
				{
					"type": "paragraph",
					"attrs": {
						"id": "bc05908a-a520-5c9f-b512-f3eff46c3c91"
					},
					"content": [
						{
							"type": "text",
							"text": "To the right, as one enters there is a stage, air hockey table, and table seating. This is our "
						},
						{
							"type": "text",
							"text": "Arts & Entertainment Arena.",
							"marks": [
								{
									"type": "bold"
								}
							]
						},
						{
							"type": "text",
							"text": " "
						},
						{
							"type": "text",
							"text": "Entry to the center is free along with all games, use of instruments, and concerts.",
							"marks": [
								{
									"type": "italic"
								}
							]
						}
					]
				},
				{
					"type": "paragraph",
					"attrs": {
						"id": "3c67ee95-e738-5856-9480-8aaa57bf37f4"
					},
					"content": [
						{
							"type": "text",
							"text": "To the left, as one enters the center she will find pool tables, a basketball game, a bumper pool, and foosball table games in the "
						},
						{
							"type": "text",
							"text": "Amusement",
							"marks": [
								{
									"type": "bold"
								}
							]
						},
						{
							"type": "text",
							"text": " and "
						},
						{
							"type": "text",
							"text": "Recreation Arena.",
							"marks": [
								{
									"type": "bold"
								}
							]
						},
						{
							"type": "text",
							"text": " "
						},
						{
							"type": "text",
							"text": "All games are always free!",
							"marks": [
								{
									"type": "italic"
								}
							]
						}
					]
				},
				{
					"type": "heading",
					"attrs": {
						"id": "41c92d92-d5a9-5efe-9e5d-ac4353f4c007",
						"level": 2
					},
					"content": [
						{
							"type": "text",
							"text": "Arts & Entertainment"
						}
					]
				},
				{
					"type": "paragraph",
					"attrs": {
						"id": "5211c0f9-bc86-506c-b991-4e161e865901"
					},
					"content": [
						{
							"type": "text",
							"text": "Live music concerts, Open MIC nights, and other entertainment happen here. Teens create delicious desserts in our kitchen. Culinary arts are performed here to the delight of many."
						}
					]
