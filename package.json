{
	"name": "we-value-teens",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"scripts": {
		"dev": "pnpm run build && vite dev",
		"build": "vite build && node scripts/generate-static-files.mjs && node scripts/search-index.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:unit": "vitest --project server",
		"test:e2e": "playwright test",
		"assert:clean-pages": "node scripts/assert-clean-pages.mjs"
	},
	"dependencies": {
		"uncial": "^2.0.1",
		"uncial-cms": "^2.0.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"pagefind": "^1.5.2",
		"svelte": "^5.56.10",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	}
}
